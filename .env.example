# DAO「ポイント交換」の自動連署ボット（サーバー専用。docs/DAO.md の「自動連署ボット」を参照）。
# KASANE_DAO_BOT が 1 でなければ何もしない（従来どおり、管理者が手動で連署）。実際の値は、サーバーの環境変数（systemd の EnvironmentFile など）に書く。.env は git に入れない。
KASANE_DAO_BOT=0
KASANE_DAO_BOT_KEY_FILE=/etc/kasane/dao-bot.key
KASANE_DAO_BOT_DAO=
KASANE_DAO_BOT_NODE=https://
KASANE_DAO_BOT_NETWORK=mainnet
# KASANE_DAO_BOT_MAX_QTY=10
# KASANE_DAO_BOT_POLL_SEC=15
# KASANE_DAO_BOT_DRY_RUN=1

# NEM 版 DAO「特典の交換」の自動引き渡しボット（サーバー専用。docs/NEM_DAO.md の「自動引き渡しボット」を参照）。
# KASANE_NEM_DAO_BOT が 1 でなければ何もしない（従来どおり、管理者が手動で渡す）。
KASANE_NEM_DAO_BOT=0
KASANE_NEM_DAO_BOT_KEY_FILE=/etc/kasane/nem-dao-bot.key
KASANE_NEM_DAO_BOT_DAO=
KASANE_NEM_DAO_BOT_NODE=https://
KASANE_NEM_DAO_BOT_NETWORK=mainnet
# KASANE_NEM_DAO_BOT_MAX_QTY=10
# KASANE_NEM_DAO_BOT_MAX_AGE_HOURS=24
# KASANE_NEM_DAO_BOT_POLL_SEC=30
# KASANE_NEM_DAO_BOT_MAX_PER_TICK=10
# KASANE_NEM_DAO_BOT_DRY_RUN=1
