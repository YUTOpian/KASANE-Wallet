const REQUEST_TIMEOUT_MS = 8000;

// --- node selection ---------------------------------------------------------------------
const activeNode: Partial<Record<SymbolNetwork, string>> = {};
const badNodes = new Set<string>();
// 利用不可時の自動切替: the node picked in 設定 stops answering -> requests go to the other saved nodes,
// then to an automatically chosen one, until the picked node is tried again.
const failedSelected = new Map<string, number>();
const SELECTED_RETRY_MS = 5 * 60 * 1000;
const switchListeners = new Set<(from: string, to: string) => void>();
onNetworkSettingsChange(() => {
  delete activeNode.mainnet;
  delete activeNode.testnet;
  delete activeNode.mijin;
  failedSelected.clear();
});

function selectedIsFailing(url: string): boolean {
  const at = failedSelected.get(url);
  if (at === undefined) return false;
  if (Date.now() - at > SELECTED_RETRY_MS) {
    failedSelected.delete(url);
    return false;
  }
  return true;
}

/** Called when requests moved from the picked node to another one (the app tells the person). */
export function onNodeSwitched(listener: (from: string, to: string) => void): () => void {
  switchListeners.add(listener);
  return () => switchListeners.delete(listener);
}

async function fetchJson<T>(url: string, init?: RequestInit, timeoutMs = REQUEST_TIMEOUT_MS): Promise<T> {
  const controller = new AbortController();
  const timer = setTimeout(() => controller.abort(), timeoutMs);
  try {
    const res = await fetch(url, { ...init, signal: controller.signal });
    if (!res.ok) {
      let message = `HTTP ${res.status}`;
      try {
        const body = await res.json();
        if (body && typeof body.message === 'string') message = body.message;
      } catch { /* not JSON */ }
      const err = new Error(message) as Error & { status?: number };
      err.status = res.status;
      throw err;
    }
    return (await res.json()) as T;
  } finally {
    clearTimeout(timer);
  }
}

// A node that has fallen behind the chain (it is up, but not synchronised) still answers "healthy", and shows
// an out-of-date state: a balance that arrived since looks like zero ("no resource exists"). So a node is also
// checked for being up to date: how old its newest block is, measured on the node's own network clock (the
// device clock is not used, so a wrong device clock cannot make every node look behind).
const MAX_NODE_LAG_MS = 3 * 60_000;

/** How far the node's newest block is behind the node's own network time (ms), or null when that could not be read. */
async function nodeLagMs(url: string): Promise<number | null> {
  try {
    const [chain, time] = await Promise.all([
      fetchJson<{ height?: string }>(`${url}/chain/info`, undefined, 5000),
      fetchJson<{ communicationTimestamps?: { receiveTimestamp?: string } }>(`${url}/node/time`, undefined, 5000),
    ]);
    const now = time.communicationTimestamps?.receiveTimestamp;
    if (!chain.height || !now) return null;
    const block = await fetchJson<{ block?: { timestamp?: string } }>(`${url}/blocks/${chain.height}`, undefined, 5000);
    const stamp = block.block?.timestamp;
    if (!stamp) return null;
    return Number(now) - Number(stamp);
  } catch {
    return null; // cannot tell: do not turn a node away for that
  }
}

/** A node is usable when it is healthy, belongs to the network we expect and is up to date. */
async function probeNode(url: string, cfg: NetworkConfig): Promise<boolean> {
  if (cfg.generationHash === '') return false; // mijin v2 before its parameters were read: there is nothing to compare with
  try {
    const [health, info] = await Promise.all([
      fetchJson<{ status?: { apiNode?: string; db?: string } }>(`${url}/node/health`, undefined, 5000),
      fetchJson<{ networkGenerationHashSeed?: string; networkIdentifier?: number }>(`${url}/node/info`, undefined, 5000),
    ]);
    const healthy = health.status?.apiNode === 'up' && health.status?.db === 'up';
    const sameNetwork = info.networkGenerationHashSeed?.toUpperCase() === cfg.generationHash && info.networkIdentifier === cfg.networkByte;
    if (!healthy || !sameNetwork) return false;
    const lag = await nodeLagMs(url);
    if (lag !== null && lag > MAX_NODE_LAG_MS) {
      logWarn('node', `${url} は同期が遅れているため使わない（最新ブロックが ${Math.round(lag / 1000)} 秒前） / ${url} is behind the chain (newest block ${Math.round(lag / 1000)} s old), not used`);
      return false;
    }
    return true;
  } catch {
    return false;
  }
}

async function discoverCandidates(cfg: NetworkConfig): Promise<string[]> {
  // mijin v2 has no public node directory: the nodes the person registered are the only candidates.
  if (cfg.key === 'mijin') return getSavedNodes('mijin');
  const found: string[] = [];
  try {
    const nodes = await fetchJson<Array<{ apiStatus?: { restGatewayUrl?: string; isAvailable?: boolean } }>>(
      `${cfg.statisticsService}/nodes?filter=preferred&limit=12&ssl=true&order=random`,
      undefined,
      6000,
    );
    for (const n of nodes) {
      const url = n.apiStatus?.restGatewayUrl;
      if (url && n.apiStatus?.isAvailable !== false && url.startsWith('https://')) found.push(url.replace(/\/+$/, ''));
    }
  } catch {
    // directory unreachable: the built-in list below still works
  }
  return [...found, ...cfg.fallbackNodes];
}

// Returns the first candidate that answers the probe (all candidates are probed in parallel).
// A node that failed its probe (the host does not exist any more, it is down, wrong network) is not probed again
// for a few minutes: the directory and the built-in list keep naming dead hosts, and probing them on every node
// search only costs time (and fills the browser console with failed requests).
const PROBE_FAILED_TTL_MS = 5 * 60_000;
const probeFailedAt = new Map<string, number>();

async function firstHealthy(candidates: string[], cfg: NetworkConfig): Promise<string | null> {
  const now = Date.now();
  const list = candidates.filter((c) => !badNodes.has(c) && !((probeFailedAt.get(c) ?? 0) + PROBE_FAILED_TTL_MS > now));
  if (list.length === 0) return null;
  return new Promise((resolve) => {
    let pending = list.length;
    let done = false;
    for (const url of list) {
      probeNode(url, cfg).then((ok) => {
        if (ok) probeFailedAt.delete(url); else probeFailedAt.set(url, Date.now());
        if (done) return;
        if (ok) {
          done = true;
          resolve(url);
        } else if (--pending === 0) {
          resolve(null);
        }
      });
    }
  });
}

/** Resolves with the first non-null answer (null when every one of them is null). */
function firstNonNull<T>(tasks: Array<Promise<T | null>>): Promise<T | null> {
  return new Promise((resolve) => {
    let pending = tasks.length;
    let done = false;
    for (const task of tasks) {
      task.catch(() => null).then((value) => {
        if (done) return;
        if (value !== null) {
          done = true;
          resolve(value);
        } else if (--pending === 0) {
          resolve(null);
        }
      });
    }
  });
}

// Several requests often start together right after a network switch: they share one node search instead of each
// probing every node (which also made them end up on different nodes).
const resolving = new Map<string, Promise<string>>();

export function resolveNode(forceRefresh = false): Promise<string> {
  const network = getNetwork();
  const running = resolving.get(`${network}:f`) ?? (forceRefresh ? undefined : resolving.get(`${network}:n`));
  if (running) return running;
  const key = `${network}:${forceRefresh ? 'f' : 'n'}`;
  const task = resolveNodeNow(forceRefresh).finally(() => { if (resolving.get(key) === task) resolving.delete(key); });
  resolving.set(key, task);
  return task;
}

async function resolveNodeNow(forceRefresh: boolean): Promise<string> {
  const network = getNetwork();
  const cfg = getNetworkConfig(network);
  if (cfg.generationHash === '') throw new Error('network_not_configured'); // mijin v2: set up its node first (設定 > ノード)
  const custom = getCustomNode(network);
  const switching = custom !== '' && getAutoSwitch() && selectedIsFailing(custom);
  if (custom && !switching) return custom; // the picked node is used as long as it answers
  if (!forceRefresh && activeNode[network]) return activeNode[network]!;
  // Picked node failing: the other saved nodes come first, then the automatic choice.
  let node: string | null = null;
  if (switching) node = await firstHealthy(getSavedNodes(network).filter((u) => u !== custom && !selectedIsFailing(u)), cfg);
  if (!node) {
    // The built-in nodes are probed while the public node directory is still being read, so a slow directory
    // (up to 6 s) does not hold up the first request after switching network: whichever answers first wins.
    node = await firstNonNull([
      firstHealthy(cfg.fallbackNodes, cfg),
      discoverCandidates(cfg).then((list) => firstHealthy(list, cfg)),
    ]);
  }
  if (!node) {
    badNodes.clear();
    probeFailedAt.clear(); // nothing answered: everything is worth another try
    node = await firstHealthy(cfg.fallbackNodes, cfg);
  }
  if (!node) throw new Error('no_node_available');
  activeNode[network] = node;
  if (switching) {
    logWarn('node', `選んだノード ${custom} が応答しないため ${node} に切り替え / picked node ${custom} is not answering, switched to ${node}`);
    switchListeners.forEach((l) => l(custom, node!));
  } else {
    logInfo('node', `${network}: using ${node} (auto)`);
  }
  return node;
}

/** The node requests currently go to: the hand-entered one, else the automatically chosen one ('' if none picked yet). */
export function getConnectedNode(): string {
  const network = getNetwork();
  const custom = getCustomNode(network);
  if (custom && !(getAutoSwitch() && selectedIsFailing(custom))) return custom;
  return activeNode[network] || '';
}

/** True while requests are going to another node because the picked one does not answer. */
export function isNodeSwitched(): boolean {
  const custom = getCustomNode();
  return custom !== '' && getAutoSwitch() && selectedIsFailing(custom);
}

export interface NodeDiagnosis {
  url: string;
  ok: boolean;
  detail: string; // response time ("123 ms") or why it failed
}

/** Probes every candidate node (the public node directory plus the built-in list) for the Settings picker; healthy ones first, fastest first. */
export async function diagnoseSymbolNodes(): Promise<NodeDiagnosis[]> {
  const cfg = getNetworkConfig(getNetwork());
  const candidates = Array.from(new Set(await discoverCandidates(cfg)));
  const results = await Promise.all(candidates.map(async (url): Promise<NodeDiagnosis & { ms: number }> => {
    const started = Date.now();
    const ok = await probeNode(url, cfg);
    const ms = Date.now() - started;
    return { url, ok, ms, detail: ok ? `${ms} ms` : 'NG' };
  }));
  results.sort((a, b) => Number(b.ok) - Number(a.ok) || a.ms - b.ms);
  return results.map(({ url, ok, detail }) => ({ url, ok, detail }));
}

/** 接続テスト of one node: reachable, healthy and on the expected network, with the response time. */
export async function testNode(url: string, network: SymbolNetwork): Promise<NodeDiagnosis> {
  const clean = url.trim().replace(/\/+$/, '');
  const started = Date.now();
  const ok = await probeNode(clean, getNetworkConfig(network));
  const ms = Date.now() - started;
  if (ok) failedSelected.delete(clean);
  logInfo('node', `connection test ${clean}: ${ok ? `OK ${ms} ms` : 'NG'}`);
  return { url: clean, ok, detail: ok ? `${ms} ms` : 'NG' };
}

/** Checks a hand-entered node URL (used by the settings screen before saving it). */
export async function checkNode(url: string, network: SymbolNetwork): Promise<boolean> {
  return probeNode(url.trim().replace(/\/+$/, ''), getNetworkConfig(network));
}

export async function nodeRequest<T>(path: string, init?: RequestInit): Promise<T> {
  let lastError: unknown;
  for (let attempt = 0; attempt < 3; attempt += 1) {
    const node = await resolveNode(attempt > 0);
    const started = Date.now();
    const what = `${init?.method ?? 'GET'} ${path.split('?')[0]}`;
    try {
      const result = await fetchJson<T>(`${node}${path}`, init);
      logDebug('node', `${what} ← ${node.replace(/^https?:\/\//, '')} ${Date.now() - started} ms`);
      return result;
    } catch (e) {
      lastError = e;
      const status = (e as { status?: number }).status;
      logWarn('node', `${what} ✗ ${node.replace(/^https?:\/\//, '')} ${Date.now() - started} ms: ${(e as Error).message}${attempt < 2 ? ' (retrying)' : ''}`);
      // A definite answer from the node (404 unknown account, 409/4xx rejection) is not a node failure.
      if (status !== undefined && status < 500) throw e;
      const custom = getCustomNode();
      if (custom && (!getAutoSwitch() || node === custom)) {
        if (!getAutoSwitch()) throw e; // the person asked to stay on the picked node
        failedSelected.set(custom, Date.now()); // 自動切替: the next attempt goes to another node
        delete activeNode[getNetwork()];
        continue;
      }
      badNodes.add(node);
      delete activeNode[getNetwork()];
    }
  }
  throw lastError instanceof Error ? lastError : new Error('request_failed');
}

// --- mosaic metadata --------------------------------------------------------------------
export interface MosaicInfo {
  id: string;
  divisibility: number;
  symbol: string; // XYM, or the namespace name (e.g. "company.token"), or the hex id
  name: string | null; // full namespace name when one is registered
  transferable: boolean;
}

const mosaicInfoCache: Record<string, MosaicInfo> = {};
const aliasCache: Record<string, string> = {};

function cacheKey(id: string): string {
  return `${getNetwork()}:${id}`;
}

function xymInfo(): MosaicInfo {
  const cfg = getNetworkConfig();
  return { id: cfg.currencyMosaicId, divisibility: CURRENCY_DIVISIBILITY, symbol: CURRENCY_SYMBOL, name: 'symbol.xym', transferable: true };
}

/** Namespace-alias ids (high bit set) used in transactions -> the real mosaic id. */
export async function resolveMosaicId(id: string): Promise<string> {
  const upper = id.toUpperCase();
  if (upper === XYM_NAMESPACE_ID) return getNetworkConfig().currencyMosaicId;
  const isAlias = (BigInt(`0x${upper}`) >> 63n) === 1n;
  if (!isAlias) return upper;
  const key = cacheKey(upper);
  if (aliasCache[key]) return aliasCache[key];
  try {
    const res = await nodeRequest<{ namespace?: { alias?: { type?: number; mosaicId?: string } } }>(`/namespaces/${upper}`);
    const alias = res.namespace?.alias;
    if (alias?.type === 1 && alias.mosaicId) {
      aliasCache[key] = alias.mosaicId.toUpperCase();
      return aliasCache[key];
    }
  } catch { /* unknown alias */ }
  return upper;
}

export async function getMosaicInfos(ids: string[]): Promise<Record<string, MosaicInfo>> {
  const cfg = getNetworkConfig();
  const result: Record<string, MosaicInfo> = {};
  const missing: string[] = [];
  for (const raw of new Set(ids.map((i) => i.toUpperCase()))) {
    if (raw === cfg.currencyMosaicId) {
      result[raw] = xymInfo();
    } else if (mosaicInfoCache[cacheKey(raw)]) {
      result[raw] = mosaicInfoCache[cacheKey(raw)];
    } else {
      missing.push(raw);
    }
  }
  if (missing.length === 0) return result;

  const infos: Record<string, { divisibility: number; transferable: boolean }> = {};
  const names: Record<string, string> = {};
  try {
    const mosaics = await nodeRequest<Array<{ mosaic: { id: string; divisibility: number; flags: number } }>>('/mosaics', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mosaicIds: missing }),
    });
    for (const m of mosaics) infos[m.mosaic.id.toUpperCase()] = { divisibility: m.mosaic.divisibility, transferable: (m.mosaic.flags & 2) !== 0 };
  } catch (e) {
    console.warn('Failed to load mosaic info', e);
  }
  try {
    const res = await nodeRequest<{ mosaicNames: Array<{ mosaicId: string; names: string[] }> }>('/namespaces/mosaic/names', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mosaicIds: missing }),
    });
    for (const entry of res.mosaicNames) if (entry.names.length > 0) names[entry.mosaicId.toUpperCase()] = entry.names[0];
  } catch (e) {
    console.warn('Failed to load mosaic names', e);
  }
  for (const id of missing) {
    const known = infos[id];
    const info: MosaicInfo = {
      id,
      divisibility: known?.divisibility ?? 0,
      symbol: names[id] ?? id,
      name: names[id] ?? null,
      transferable: known?.transferable ?? true,
    };
    // Only cache what the node actually answered, so a transient failure is retried next time.
    if (known) mosaicInfoCache[cacheKey(id)] = info;
    result[id] = info;
  }
  return result;
}

/** Info of a mosaic given by id (16 hex chars), or null when the chain has no such mosaic. Throws on a network failure. */
export async function fetchExistingMosaicInfo(id: string): Promise<MosaicInfo | null> {
  const upper = id.toUpperCase();
  if (!/^[0-9A-F]{16}$/.test(upper)) return null;
  try {
    await nodeRequest(`/mosaics/${upper}`);
  } catch (e) {
    if ((e as { status?: number }).status === 404) return null;
    throw e;
  }
  return (await getMosaicInfos([upper]))[upper] ?? null;
}

// --- balances ---------------------------------------------------------------------------
export interface MosaicBalance extends MosaicInfo {
  amount: bigint; // atomic units
  balance: string; // plain decimal string
  /** NEM only: the mosaic's supply in whole units (absent = its definition could not be read, so it is not offered for sending). */
  supply?: bigint;
  /** NEM only: the mosaic charges a levy to the sender. */
  hasLevy?: boolean;
}

export async function fetchBalances(address: string): Promise<MosaicBalance[]> {
  const cfg = getNetworkConfig();
  let owned: Array<{ id: string; amount: string }> = [];
  try {
    const res = await nodeRequest<{ account: { mosaics: Array<{ id: string; amount: string }> } }>(`/accounts/${normalizeAddress(address)}`);
    owned = res.account.mosaics ?? [];
  } catch (e) {
    // 404 = the address has never received anything: a legitimate zero balance.
    if ((e as { status?: number }).status !== 404) throw e;
  }
  const infos = await getMosaicInfos([cfg.currencyMosaicId, ...owned.map((m) => m.id)]);
  const byId = new Map(owned.map((m) => [m.id.toUpperCase(), BigInt(m.amount)]));
  const ids = [cfg.currencyMosaicId, ...[...byId.keys()].filter((id) => id !== cfg.currencyMosaicId)];
  const balances = ids.map((id) => {
    const info = infos[id] ?? { id, divisibility: 0, symbol: id, name: null, transferable: true };
    const amount = byId.get(id) ?? 0n;
    return { ...info, amount, balance: formatAtomic(amount, info.divisibility) };
  });
  // Remember what this account holds, so 「オフライン署名」 (no node there) can offer the mosaics to choose from.
  // Only mosaics the node described (a mosaic missing from the cache above had its info request fail - its
  // divisibility is a guess) and that can be sent.
  void saveKnownMosaics(getNetwork(), address, balances
    .filter((b) => b.id !== cfg.currencyMosaicId && b.amount > 0n && b.transferable && mosaicInfoCache[cacheKey(b.id)] !== undefined)
    .map((b) => ({ id: b.id, symbol: b.symbol, name: b.name, divisibility: b.divisibility })));
  return balances;
}

// --- recipient info ---------------------------------------------------------------------
export interface RecipientInfo {
  /** false = the node has never seen this address (nothing was ever sent to it or from it). */
  exists: boolean;
  /** The account's public key, or null while it has none on chain (it only appears after the first outgoing transaction). */
  publicKey: string | null;
  /** Everything the address holds (balance above zero), XYM first. */
  mosaics: MosaicBalance[];
  /** XYM balance as a plain decimal string. */
  xym: string;
  /** Full names of the namespaces the address owns and that have not expired. */
  namespaces: string[];
  /** The address's latest transfers (newest first), seen from the address's own side. */
  recent: SymbolTransfer[];
}

/** The public key an address has on chain (null while it has none), and whether the node knows the address at all. */
export async function fetchAccountPublicKey(address: string): Promise<{ exists: boolean; publicKey: string | null }> {
  const normalized = normalizeAddress(address);
  try {
    const res = await nodeRequest<{ account: { publicKey?: string; publicKeyHeight?: string } }>(`/accounts/${normalized}`);
    const key = (res.account.publicKey ?? '').toUpperCase();
    // An account that has only received funds has an all-zero key and publicKeyHeight "0".
    if (/^[0-9A-F]{64}$/.test(key) && !/^0+$/.test(key) && res.account.publicKeyHeight !== '0') return { exists: true, publicKey: key };
    return { exists: true, publicKey: null };
  } catch (e) {
    // 404 = unknown address: a valid address that has never been used.
    if ((e as { status?: number }).status !== 404) throw e;
    return { exists: false, publicKey: null };
  }
}

/**
 * Importance of an account as a percentage of the network's total importance (null when the node does not
 * know the account or the figures are unavailable), and the namespace names that are aliases of its address.
 */
export async function fetchAccountOverview(address: string): Promise<{ importancePercent: number | null; aliases: string[] }> {
  const normalized = normalizeAddress(address);
  let importancePercent: number | null = null;
  try {
    const [acc, props] = await Promise.all([
      nodeRequest<{ account: { importance?: string } }>(`/accounts/${normalized}`),
      nodeRequest<{ chain?: { totalChainImportance?: string } }>('/network/properties'),
    ]);
    const imp = Number((acc.account.importance ?? '0').replace(/'/g, ''));
    const total = Number((props.chain?.totalChainImportance ?? '0').replace(/'/g, ''));
    if (Number.isFinite(imp) && total > 0) importancePercent = (imp / total) * 100;
  } catch {
    importancePercent = null;
  }
  let aliases: string[] = [];
  try {
    const res = await nodeRequest<{ accountNames: Array<{ names: string[] }> }>('/namespaces/account/names', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ addresses: [normalized] }),
    });
    aliases = res.accountNames?.[0]?.names ?? [];
  } catch {
    aliases = [];
  }
  return { importancePercent, aliases };
}

// --- recipient given as an alias or a public key ----------------------------------------
export type RecipientResolution =
  | { ok: true; address: string; via: 'alias' | 'publicKey'; label: string }
  | { ok: false; reason: 'not_found' | 'no_address_alias' | 'expired' | 'wrong_network' | 'invalid' };

interface RawNamespaceEntry {
  meta?: { active?: boolean };
  namespace: { ownerAddress?: string; endHeight: string; alias?: { type?: number; address?: string } };
}

async function fetchNamespaceEntry(id: string): Promise<RawNamespaceEntry | null> {
  try {
    return await nodeRequest<RawNamespaceEntry>(`/namespaces/${id}`);
  } catch (e) {
    if ((e as { status?: number }).status === 404) return null;
    throw e;
  }
}

/** The address a namespace name is linked to right now, or why it cannot be used. Never returns a stale alias. */
async function resolveAddressAlias(name: string, networkByte: number): Promise<RecipientResolution> {
  const labels = namespaceLabels(name);
  if (!labels) return { ok: false, reason: 'invalid' };
  const ids = namespaceIdPath(labels);
  const [entry, root, chain] = await Promise.all([
    fetchNamespaceEntry(ids[ids.length - 1]),
    ids.length > 1 ? fetchNamespaceEntry(ids[0]) : Promise.resolve(null),
    nodeRequest<{ height: string }>('/chain/info'),
  ]);
  if (!entry) return { ok: false, reason: 'not_found' };
  const height = BigInt(chain.height);
  const live = (e: RawNamespaceEntry) => e.meta?.active !== false && (BigInt(e.namespace.endHeight) === ETERNAL_END_HEIGHT || height < BigInt(e.namespace.endHeight));
  // A child namespace is only good while its root is, and only for the root's current owner: after the
  // root lapses and someone else registers it again, the old child (and its alias) must not be trusted.
  if (!live(entry)) return { ok: false, reason: 'expired' };
  if (ids.length > 1) {
    if (!root || !live(root)) return { ok: false, reason: 'expired' };
    if ((root.namespace.ownerAddress ?? '').toUpperCase() !== (entry.namespace.ownerAddress ?? '').toUpperCase()) return { ok: false, reason: 'expired' };
  }
  const alias = entry.namespace.alias;
  if (alias?.type !== 2 || !alias.address) return { ok: false, reason: 'no_address_alias' }; // 2 = linked to an address
  const address = addressBytesToString(hexToBytes(alias.address));
  if (!isValidAddress(address, networkByte)) return { ok: false, reason: 'wrong_network' };
  return { ok: true, address, via: 'alias', label: name };
}

/**
 * Turns a typed recipient that is not an address - a namespace alias such as "nem.group" or a 64-hex
 * public key - into the address it stands for. The caller shows that address and sends to it directly.
 */
export async function resolveRecipientInput(input: RecipientInput, networkByte: number): Promise<RecipientResolution> {
  if (input.kind === 'publicKey') {
    return { ok: true, address: addressFromPublicKey(input.publicKey, networkByte), via: 'publicKey', label: input.publicKey };
  }
  if (input.kind === 'alias') return resolveAddressAlias(input.name, networkByte);
  return { ok: false, reason: 'invalid' };
}

/** What the chain knows about a recipient address; shown under the address field of the send form. */
export async function fetchRecipientInfo(address: string, recentCount = 6): Promise<RecipientInfo> {
  const normalized = normalizeAddress(address);
  const { exists, publicKey } = await fetchAccountPublicKey(normalized);
  if (!exists) return { exists, publicKey, mosaics: [], xym: '0', namespaces: [], recent: [] };

  const cfg = getNetworkConfig();
  const [balances, owned, recent] = await Promise.all([
    fetchBalances(normalized).catch(() => [] as MosaicBalance[]),
    fetchOwnedNamespaces(normalized).catch(() => [] as OwnedNamespace[]),
    fetchTransfers(normalized, recentCount, false).catch(() => [] as SymbolTransfer[]),
  ]);
  return {
    exists,
    publicKey,
    mosaics: balances.filter((b) => b.amount > 0n),
    xym: balances.find((b) => b.id.toUpperCase() === cfg.currencyMosaicId)?.balance ?? '0',
    namespaces: owned.filter((n) => !n.expired).map((n) => n.name),
    recent,
  };
}

// --- history ----------------------------------------------------------------------------
export interface SymbolTransfer {
  hash: string;
  timestampMs: number;
  isReception: boolean;
  isConfirmed: boolean;
  senderAddress: string;
  receiverAddress: string; // base32 address, or "@namespace" placeholder for alias recipients
  mosaics: Array<{ id: string; symbol: string; amount: string }>;
  message: string;
  encryptedMessage: boolean;
  /** NEM only: the encrypted message payload (hex) and the sender's public key, for decrypting it on the detail screen. */
  encryptedPayload?: string;
  signerPublicKey?: string;
  fee: string; // XYM
}

interface RawTx {
  meta?: { hash?: string; aggregateHash?: string; timestamp?: string; feeMultiplier?: number };
  transaction: {
    type: number;
    network: number;
    signerPublicKey: string;
    recipientAddress?: string;
    mosaics?: Array<{ id: string; amount: string }>;
    message?: string;
    maxFee?: string;
    size?: number;
  };
}

async function toTransfer(raw: RawTx, myAddress: string, confirmed: boolean): Promise<SymbolTransfer | null> {
  const cfg = getNetworkConfig();
  const tx = raw.transaction;
  if (tx.type !== TX_TYPE_TRANSFER || !tx.recipientAddress) return null;
  const sender = addressFromPublicKey(tx.signerPublicKey, tx.network);
  const recipientBytes = hexToBytes(tx.recipientAddress);
  // Unresolved recipient: the first byte's low bit flags a namespace alias instead of an address.
  const aliasRecipient = (recipientBytes[0] & 1) === 1;
  const receiver = aliasRecipient ? `@${bytesToHex(recipientBytes.slice(1, 9))}` : addressBytesToString(recipientBytes);
  const me = normalizeAddress(myAddress);
  // A transfer signed by someone else is a reception; an alias recipient ("@...") cannot be compared with the address here.
  const isReception = sender !== me && (receiver === me || aliasRecipient);

  const resolvedIds = await Promise.all((tx.mosaics ?? []).map((m) => resolveMosaicId(m.id)));
  const infos = await getMosaicInfos(resolvedIds);
  const mosaics = (tx.mosaics ?? []).map((m, i) => {
    const info = infos[resolvedIds[i]] ?? { id: resolvedIds[i], divisibility: 0, symbol: resolvedIds[i] };
    return { id: resolvedIds[i], symbol: info.symbol, amount: formatAtomic(BigInt(m.amount), info.divisibility) };
  });

  let message = '';
  let encryptedMessage = false;
  if (tx.message && tx.message.length >= 2) {
    const bytes = hexToBytes(tx.message);
    if (bytes[0] === 1) encryptedMessage = true;
    else if (apostilleHexFromMessageField(tx.message)) message = APOSTILLE_MESSAGE_LABEL; // binary (hash / signature): not text
    else message = new TextDecoder().decode(bytes.slice(1));
  }

  let feeAtomic: bigint | null = null;
  if (raw.meta?.feeMultiplier !== undefined && tx.size) feeAtomic = BigInt(tx.size) * BigInt(raw.meta.feeMultiplier);
  else if (tx.maxFee) feeAtomic = BigInt(tx.maxFee);

  const timestampMs = raw.meta?.timestamp !== undefined && confirmed
    ? Number(raw.meta.timestamp) + cfg.epochAdjustment * 1000
    : Date.now();

  return {
    hash: raw.meta?.hash ?? raw.meta?.aggregateHash ?? '',
    timestampMs,
    isReception,
    isConfirmed: confirmed,
    senderAddress: sender,
    receiverAddress: receiver,
    mosaics,
    message,
    encryptedMessage,
    fee: feeAtomic === null ? '' : formatAtomic(feeAtomic, CURRENCY_DIVISIBILITY),
  };
}

export async function fetchTransfers(address: string, count: number, includeUnconfirmed = true): Promise<SymbolTransfer[]> {
  const addr = normalizeAddress(address);
  const pageSize = Math.min(Math.max(count, 10), 100);
  const query = `address=${addr}&type=${TX_TYPE_TRANSFER}&order=desc&pageSize=${pageSize}`;
  const [confirmed, unconfirmed] = await Promise.all([
    nodeRequest<{ data: RawTx[] }>(`/transactions/confirmed?${query}&embedded=true`),
    includeUnconfirmed
      ? nodeRequest<{ data: RawTx[] }>(`/transactions/unconfirmed?${query}`).catch(() => ({ data: [] as RawTx[] }))
      : Promise.resolve({ data: [] as RawTx[] }),
  ]);
  const [c, u] = await Promise.all([
    Promise.all(confirmed.data.map((r) => toTransfer(r, addr, true))),
    Promise.all(unconfirmed.data.map((r) => toTransfer(r, addr, false))),
  ]);
  const list = [...u, ...c].filter((t): t is SymbolTransfer => t !== null);
  return list.slice(0, count);
}

/**
 * Transfers exchanged between the wallet and one counterparty (newest first): the ones the wallet
 * sent to it, the ones it sent to the wallet (when its public key is known) and, as a safety net,
 * whatever of the wallet's latest history involves it. Used by the send form to show whether the
 * typed address has been dealt with before.
 */
export async function fetchTransfersWith(
  myAddress: string,
  myPublicKey: string,
  counterparty: string,
  counterpartyPublicKey: string | null,
  limit = 20,
): Promise<SymbolTransfer[]> {
  const me = normalizeAddress(myAddress);
  const other = normalizeAddress(counterparty);
  const base = `type=${TX_TYPE_TRANSFER}&order=desc&pageSize=100&embedded=true`;
  const targeted = async (query: string): Promise<SymbolTransfer[]> => {
    try {
      const res = await nodeRequest<{ data: RawTx[] }>(`/transactions/confirmed?${query}&${base}`);
      const list = await Promise.all(res.data.map((r) => toTransfer(r, me, true)));
      return list.filter((t): t is SymbolTransfer => t !== null);
    } catch (e) {
      console.warn('Failed to load transfers with counterparty', e);
      return [];
    }
  };
  const [sent, received, recent] = await Promise.all([
    targeted(`signerPublicKey=${myPublicKey}&recipientAddress=${other}`),
    counterpartyPublicKey ? targeted(`signerPublicKey=${counterpartyPublicKey}&recipientAddress=${me}`) : Promise.resolve([] as SymbolTransfer[]),
    fetchTransfers(me, 100, true).catch(() => [] as SymbolTransfer[]),
  ]);
  const involves = (t: SymbolTransfer) => t.senderAddress === other || t.receiverAddress === other;
  const seen = new Set<string>();
  const out: SymbolTransfer[] = [];
  for (const t of [...sent, ...received, ...recent.filter(involves)]) {
    const key = t.hash || `${t.timestampMs}:${t.senderAddress}:${t.receiverAddress}`;
    if (seen.has(key)) continue;
    seen.add(key);
    out.push(t);
  }
  return out.sort((a, b) => b.timestampMs - a.timestampMs).slice(0, limit);
}

// --- sending ----------------------------------------------------------------------------
export interface FeeQuote {
  multiplier: number;
  size: number;
  fee: bigint; // atomic XYM
}

// Fee levels offered when sending (see feeSpeed.ts): five steps from the network minimum up to
// the fastest. Transactions that offer no choice pay the 「手数料の既定値」 level of 設定.
export type { FeeSpeed } from './feeSpeed';
export { FEE_SPEEDS } from './feeSpeed';

/** Fee multipliers for the five levels, from the node's recent-fee statistics (with a fallback). */
export async function feeMultipliers(): Promise<Record<FeeSpeed, number>> {
  let min = 100;
  let median = 100;
  let highest = 0;
  try {
    const f = await nodeRequest<{ medianFeeMultiplier?: number; minFeeMultiplier?: number; highestFeeMultiplier?: number }>('/network/fees/transaction');
    min = Math.max(f.minFeeMultiplier ?? 0, 1);
    median = Math.max(f.medianFeeMultiplier ?? 0, min);
    highest = f.highestFeeMultiplier ?? 0;
  } catch { /* defaults above */ }
  return multipliersFromStats(min, median, highest);
}

/** The fee of a transaction of `size` bytes at each of the five levels (one node request). */
export async function quoteFeesForSize(size: number): Promise<Record<FeeSpeed, FeeQuote>> {
  const multipliers = await feeMultipliers();
  const quote = (multiplier: number): FeeQuote => ({ multiplier, size, fee: BigInt(size) * BigInt(multiplier) });
  const out = {} as Record<FeeSpeed, FeeQuote>;
  for (const speed of FEE_SPEEDS) out[speed] = quote(multipliers[speed]);
  return out;
}

/** The fee of one transfer at each of the five levels (one node request). */
export async function quoteFees(mosaicCount: number, message: string | undefined, encrypted = false): Promise<Record<FeeSpeed, FeeQuote>> {
  return quoteFeesForSize(transferSize(mosaicCount, message, encrypted));
}

export async function quoteFee(mosaicCount: number, message: string | undefined, speed: FeeSpeed = getDefaultFeeSpeed(), encrypted = false): Promise<FeeQuote> {
  return (await quoteFees(mosaicCount, message, encrypted))[speed];
}

export async function networkTimeMs(): Promise<number> {
  const cfg = getNetworkConfig();
  try {
    const res = await nodeRequest<{ communicationTimestamps: { receiveTimestamp: string } }>('/node/time');
    return Number(res.communicationTimestamps.receiveTimestamp);
  } catch {
    return Date.now() - cfg.epochAdjustment * 1000;
  }
}

export class SymbolSendError extends Error {
  code: string;
  constructor(code: string, message?: string) {
    super(message ?? code);
    this.code = code;
  }
}

/** Announces a signed transaction and waits briefly for the node's verdict (throws SymbolSendError). */
export async function announceSigned(signed: SignedTransaction): Promise<void> {
  try {
    await nodeRequest('/transactions', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ payload: signed.payload }),
    });
  } catch (e) {
    throw new SymbolSendError('announce_failed', (e as Error).message);
  }
  logInfo('tx', `announced ${signed.hash ? `hash ${signed.hash}` : ''}`);
  // Announcing only means the node accepted the packet; validation failures (insufficient
  // balance, non-transferable mosaic, ...) show up afterwards in the transaction status.
  const deadlineAt = Date.now() + 12000;
  while (Date.now() < deadlineAt) {
    await new Promise((r) => setTimeout(r, 1500));
    try {
      const status = await nodeRequest<{ group: string; code: string }>(`/transactionStatus/${signed.hash}`);
      if (status.group === 'failed') {
        logWarn('tx', `transaction rejected: ${status.code}`);
        throw new SymbolSendError(status.code);
      }
      if (status.group === 'unconfirmed' || status.group === 'confirmed' || status.group === 'partial') break;
    } catch (e) {
      if (e instanceof SymbolSendError) throw e;
      // 404 = not seen yet; keep polling
    }
  }
}

export interface SendTransferInput {
  /** Ledger のアカウントなら空文字にして `ledgerIndex` を入れる（鍵はデバイスの外に出ない）。 */
  privateKey: string;
  ledgerIndex?: number;
  publicKey: string;
  recipient: string;
  mosaics: MosaicAmount[];
  message?: string;
  /** Encrypt the message for the recipient (needs the recipient's public key to be on chain). */
  encrypt?: boolean;
  feeSpeed?: FeeSpeed;
  /** Send with no mosaic at all (NEMonster's catch); every other transfer needs at least one mosaic. */
  allowNoMosaics?: boolean;
  /** The message field as it goes on the chain (type byte included), e.g. an apostille. Replaces `message` and `encrypt`. */
  rawMessage?: Uint8Array;
}

/** Builds and signs the transfer without announcing it (shared by sending and by the signed-transaction QR). */
async function buildSignedTransfer(input: SendTransferInput): Promise<{ signed: SignedTransaction; deadlineMs: number }> {
  const cfg = getNetworkConfig();
  if (!decodeAddress(input.recipient)) throw new SymbolSendError('invalid_recipient');
  let encryptedMessage: Uint8Array | undefined;
  // 暗号化メッセージは送り手の秘密鍵で暗号化するので、Ledger（秘密鍵を持ち出せない）では作れない。
  if (input.ledgerIndex !== undefined && input.encrypt && input.message) throw new SymbolSendError('ledger_encrypt_unsupported');
  if (input.encrypt && input.message && !input.rawMessage) {
    const { publicKey } = await fetchAccountPublicKey(input.recipient);
    if (!publicKey) throw new SymbolSendError('recipient_public_key_missing');
    encryptedMessage = encryptMessage(input.privateKey, publicKey, input.message);
  }
  const speed = input.feeSpeed ?? getDefaultFeeSpeed();
  const quote = input.rawMessage
    ? (await quoteFeesForSize(transferSizeForMessageField(input.rawMessage.length) + 16 * input.mosaics.length))[speed]
    : await quoteFee(input.mosaics.length, input.message, speed, encryptedMessage !== undefined);
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const params = {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    recipient: input.recipient,
    mosaics: input.mosaics,
    message: input.message,
    encryptedMessage,
    rawMessage: input.rawMessage,
    maxFee: quote.fee,
    deadline,
    allowNoMosaics: input.allowNoMosaics,
  };
  const ledgerIndex = input.ledgerIndex;
  const signed = ledgerIndex !== undefined
    ? await signTransferWith(
      (payload) => signWithLedger('symbol', ledgerIndex, input.publicKey, cfg.networkByte, payload, verifySignature),
      cfg.generationHash,
      params,
    )
    : signTransfer(input.privateKey, cfg.generationHash, params);
  return { signed, deadlineMs: Number(deadline) + cfg.epochAdjustment * 1000 };
}

export async function sendTransfer(input: SendTransferInput): Promise<{ hash: string }> {
  const { signed } = await buildSignedTransfer(input);
  await announceSigned(signed);
  return { hash: signed.hash };
}

/**
 * Signs the transfer but does not announce it: the signed transaction is handed to someone else (a QR code)
 * who announces it. It expires two hours after signing, like a transfer sent from this wallet.
 */
export async function signTransferForExport(input: SendTransferInput): Promise<SignedTransaction & { deadlineMs: number }> {
  const { signed, deadlineMs } = await buildSignedTransfer(input);
  return { ...signed, deadlineMs };
}

// --- mosaic creation ----------------------------------------------------------------------
export interface OwnedMosaic {
  id: string;
  symbol: string; // namespace name when one is linked, else the hex id
  supply: bigint; // atomic units
  supplyText: string; // plain decimal string
  divisibility: number;
  flags: number;
  duration: bigint; // blocks; 0n = never expires
}

/** Mosaics created by this address, newest first. */
export async function fetchOwnedMosaics(address: string): Promise<OwnedMosaic[]> {
  const res = await nodeRequest<{
    data: Array<{ mosaic: { id: string; supply: string; flags: number; divisibility: number; duration: string } }>;
  }>(`/mosaics?ownerAddress=${normalizeAddress(address)}&order=desc&pageSize=100`);
  const ids = res.data.map((d) => d.mosaic.id.toUpperCase());
  const infos = ids.length > 0 ? await getMosaicInfos(ids) : {};
  return res.data.map(({ mosaic }) => {
    const id = mosaic.id.toUpperCase();
    const supply = BigInt(mosaic.supply);
    return {
      id,
      symbol: infos[id]?.symbol ?? id,
      supply,
      supplyText: formatAtomic(supply, mosaic.divisibility),
      divisibility: mosaic.divisibility,
      flags: mosaic.flags,
      duration: BigInt(mosaic.duration),
    };
  });
}

/** One line of the mosaic table: a mosaic this address holds and/or created, with everything the table shows. */
export interface MosaicRow {
  id: string;
  name: string | null; // linked namespace name, if any
  supplyText: string;
  supply: bigint; // atomic units
  balance: string; // plain decimal string
  amount: bigint; // atomic units
  divisibility: number;
  flags: number;
  duration: bigint; // blocks; 0n = never expires
  expired: boolean;
  expiresAtMs: number | null; // estimated; null = never expires
  createdByMe: boolean;
}

/**
 * The mosaics this address holds (XYM included) plus the ones it created, with supply, flags and expiry.
 * Held mosaics come first, then mosaics that were created but are no longer held. Throws when the balances
 * or the mosaic details cannot be loaded.
 */
export async function fetchMosaicRows(address: string): Promise<MosaicRow[]> {
  const cfg = getNetworkConfig();
  type Raw = { mosaic: { id: string; supply: string; startHeight: string; flags: number; divisibility: number; duration: string } };
  const [balances, created, chain] = await Promise.all([
    fetchBalances(address),
    nodeRequest<{ data: Raw[] }>(`/mosaics?ownerAddress=${normalizeAddress(address)}&order=desc&pageSize=100`)
      .then((r) => r.data)
      .catch((e) => { console.warn('Failed to load created mosaics', e); return [] as Raw[]; }),
    nodeRequest<{ height: string }>('/chain/info'),
  ]);
  const height = BigInt(chain.height);
  const details = new Map<string, Raw['mosaic']>();
  for (const r of created) details.set(r.mosaic.id.toUpperCase(), r.mosaic);
  const createdIds = new Set(details.keys());

  const held = balances.filter((b) => b.amount > 0n || b.id === cfg.currencyMosaicId);
  const heldIds = new Set(held.map((b) => b.id));
  const missing = held.map((b) => b.id).filter((id) => !details.has(id));
  if (missing.length > 0) {
    const rows = await nodeRequest<Raw[]>('/mosaics', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mosaicIds: missing }),
    });
    for (const r of rows) details.set(r.mosaic.id.toUpperCase(), r.mosaic);
  }
  const createdOnly = [...createdIds].filter((id) => !heldIds.has(id));
  const infos = createdOnly.length > 0 ? await getMosaicInfos(createdOnly) : {};

  const build = (id: string, name: string | null, amount: bigint): MosaicRow | null => {
    const d = details.get(id);
    if (!d) return null;
    const duration = BigInt(d.duration);
    const end = BigInt(d.startHeight) + duration;
    const eternal = duration === 0n;
    const supply = BigInt(d.supply);
    return {
      id,
      name,
      supply,
      supplyText: formatAtomic(supply, d.divisibility),
      amount,
      balance: formatAtomic(amount, d.divisibility),
      divisibility: d.divisibility,
      flags: d.flags,
      duration,
      expired: !eternal && height >= end,
      expiresAtMs: eternal ? null : Date.now() + Number(end - height) * BLOCK_TIME_MS,
      createdByMe: createdIds.has(id),
    };
  };
  const rows: MosaicRow[] = [];
  for (const b of held) {
    const row = build(b.id, b.name, b.amount);
    if (row) rows.push(row);
  }
  for (const id of createdOnly) {
    const row = build(id, infos[id]?.name ?? null, 0n);
    if (row) rows.push(row);
  }
  return rows;
}

/** What creating a mosaic costs on top of the transaction fee (atomic XYM; paid once, not refunded). */
export async function fetchMosaicRentalFee(): Promise<bigint> {
  try {
    const res = await nodeRequest<{ effectiveMosaicRentalFee?: string }>('/network/fees/rental');
    if (res.effectiveMosaicRentalFee) return BigInt(res.effectiveMosaicRentalFee);
  } catch { /* fall back to the network default below */ }
  return DEFAULT_MOSAIC_RENTAL_FEE;
}

/** Transaction fee (atomic XYM) of the mosaic-creation aggregate at the standard level. */
export async function quoteMosaicCreationFee(metadataValueLengths: number[] = []): Promise<FeeQuote> {
  const metadataSize = metadataValueLengths.reduce((sum, len) => sum + metadataEmbeddedSize('mosaic', len), 0);
  return (await quoteFeesForSize(MOSAIC_CREATION_SIZE + metadataSize))[getDefaultFeeSpeed()];
}

export interface CreateMosaicInput {
  privateKey: string;
  publicKey: string;
  address: string; // the owner's address on the current network
  supply: bigint; // initial supply, atomic units
  divisibility: number;
  flags: number;
  durationBlocks: bigint; // 0n = never expires
  metadata?: MetadataItem[]; // optional entries set on the new mosaic in the same transaction
}

export async function createMosaic(input: CreateMosaicInput): Promise<{ hash: string; mosaicId: string }> {
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signMosaicCreation(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    ownerAddress: input.address,
    networkByte: cfg.networkByte,
    nonce: newMosaicNonce(),
    divisibility: input.divisibility,
    flags: input.flags,
    duration: input.durationBlocks,
    supply: input.supply,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
    metadata: input.metadata,
  });
  await announceSigned(signed);
  return { hash: signed.hash, mosaicId: signed.mosaicId };
}

/** Transaction fee (atomic XYM) of a standalone supply change at the standard level. */
export async function quoteMosaicSupplyChangeFee(): Promise<FeeQuote> {
  return (await quoteFeesForSize(MOSAIC_SUPPLY_CHANGE_SIZE))[getDefaultFeeSpeed()];
}

export interface ChangeMosaicSupplyInput {
  privateKey: string;
  publicKey: string;
  mosaicId: string; // 16 hex chars
  action: SupplyAction;
  delta: bigint; // atomic units
}

/** Signs and announces a mosaic supply change from the owner's own account. */
export async function changeMosaicSupply(input: ChangeMosaicSupplyInput): Promise<{ hash: string }> {
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signMosaicSupplyChange(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    mosaicId: input.mosaicId,
    action: input.action,
    delta: input.delta,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

// --- namespaces ---------------------------------------------------------------------------
export interface OwnedNamespace {
  id: string; // id of this level (16 hex chars)
  name: string; // full name, e.g. "company.team"
  depth: number; // 1 = root
  eternal: boolean; // never expires (only the network's own root namespaces)
  expired: boolean;
  expiresAtMs: number | null; // estimated; null when eternal
  aliasType: 'none' | 'mosaic' | 'address';
  alias: string; // mosaic id (hex) / address (base32); '' without an alias
}

const BLOCK_TIME_MS = 30_000;
const ETERNAL_END_HEIGHT = 18446744073709551615n;

/** Namespaces owned by this address, sorted by full name. */
export async function fetchOwnedNamespaces(address: string): Promise<OwnedNamespace[]> {
  const addr = normalizeAddress(address);
  const [list, chain] = await Promise.all([
    nodeRequest<{
      data: Array<{
        namespace: {
          depth: number; level0: string; level1?: string; level2?: string; endHeight: string;
          alias?: { type?: number; mosaicId?: string; address?: string };
        };
      }>;
    }>(`/namespaces?ownerAddress=${addr}&order=desc&pageSize=100`),
    nodeRequest<{ height: string }>('/chain/info'),
  ]);
  const height = BigInt(chain.height);
  const levelIds = (ns: { depth: number; level0: string; level1?: string; level2?: string }) =>
    [ns.level0, ns.level1, ns.level2].slice(0, ns.depth).map((id) => (id ?? '').toUpperCase());
  const allIds = [...new Set(list.data.flatMap((d) => levelIds(d.namespace)))].filter(Boolean);
  const names: Record<string, string> = {};
  if (allIds.length > 0) {
    const res = await nodeRequest<Array<{ id: string; name: string }>>('/namespaces/names', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ namespaceIds: allIds }),
    });
    for (const n of res) names[n.id.toUpperCase()] = n.name;
  }
  return list.data
    .map(({ namespace: ns }): OwnedNamespace => {
      const ids = levelIds(ns);
      const end = BigInt(ns.endHeight);
      const eternal = end === ETERNAL_END_HEIGHT;
      let aliasType: OwnedNamespace['aliasType'] = 'none';
      let alias = '';
      try {
        if (ns.alias?.type === 1 && ns.alias.mosaicId) {
          aliasType = 'mosaic';
          alias = ns.alias.mosaicId.toUpperCase();
        } else if (ns.alias?.type === 2 && ns.alias.address) {
          aliasType = 'address';
          alias = addressBytesToString(hexToBytes(ns.alias.address));
        }
      } catch { /* an alias that cannot be decoded is shown as none */ }
      return {
        id: ids[ids.length - 1],
        name: ids.map((id) => names[id] ?? id).join('.'),
        depth: ns.depth,
        eternal,
        expired: !eternal && height >= end,
        expiresAtMs: eternal ? null : Date.now() + Number(end - height) * BLOCK_TIME_MS,
        aliasType,
        alias,
      };
    })
    .sort((a, b) => a.name.localeCompare(b.name));
}

export interface NamespaceRentalFees {
  childFee: bigint; // one-off, atomic XYM
  rootFeePerBlock: bigint; // atomic XYM per block
}

/** Namespace rental prices from the node; null when it cannot be reached. */
export async function fetchNamespaceRentalFees(): Promise<NamespaceRentalFees | null> {
  try {
    const res = await nodeRequest<{ effectiveChildNamespaceRentalFee?: string; effectiveRootNamespaceRentalFeePerBlock?: string }>('/network/fees/rental');
    if (res.effectiveChildNamespaceRentalFee === undefined || res.effectiveRootNamespaceRentalFeePerBlock === undefined) return null;
    return { childFee: BigInt(res.effectiveChildNamespaceRentalFee), rootFeePerBlock: BigInt(res.effectiveRootNamespaceRentalFeePerBlock) };
  } catch {
    return null;
  }
}

/** Transaction fee (atomic XYM) of registering a namespace called `name`, at the standard level. */
export async function quoteNamespaceRegistrationFee(name: string, metadataValueLengths: number[] = []): Promise<FeeQuote> {
  if (metadataValueLengths.length === 0) return (await quoteFeesForSize(namespaceRegistrationSize(name)))[getDefaultFeeSpeed()];
  // With metadata the registration travels inside an aggregate together with the entries.
  const size = AGGREGATE_BASE_SIZE + namespaceRegistrationEmbeddedSize(name)
    + metadataValueLengths.reduce((sum, len) => sum + metadataEmbeddedSize('namespace', len), 0);
  return (await quoteFeesForSize(size))[getDefaultFeeSpeed()];
}

export interface RegisterNamespaceInput {
  privateKey: string;
  publicKey: string;
  address?: string; // the owner's address; required when `metadata` is given
  name: string; // this level's name only
  parentId?: string; // set for a child namespace
  durationBlocks?: bigint; // root namespaces only
  metadata?: MetadataItem[]; // optional entries set on the new namespace in the same transaction
}

export async function registerNamespace(input: RegisterNamespaceInput): Promise<{ hash: string; namespaceId: string }> {
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signNamespaceRegistration(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    ownerAddress: input.address,
    networkByte: cfg.networkByte,
    name: input.name,
    parentId: input.parentId,
    duration: input.durationBlocks,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
    metadata: input.metadata,
  });
  await announceSigned(signed);
  return { hash: signed.hash, namespaceId: signed.namespaceId };
}

/** Transaction fee (atomic XYM) of linking / unlinking an alias of this kind, at the standard level. */
export async function quoteAliasFee(type: AliasTarget['type']): Promise<FeeQuote> {
  return (await quoteFeesForSize(aliasTransactionSize(type)))[getDefaultFeeSpeed()];
}

export interface ChangeAliasInput {
  privateKey: string;
  publicKey: string;
  namespaceId: string; // 16 hex chars
  action: AliasAction;
  target: AliasTarget;
}

/** Signs and announces an alias link / unlink from the namespace owner's own account. */
export async function changeAlias(input: ChangeAliasInput): Promise<{ hash: string }> {
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signAlias(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    namespaceId: input.namespaceId,
    action: input.action,
    target: input.target,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

// --- metadata -----------------------------------------------------------------------------
export interface MetadataEntry {
  key: string; // scoped metadata key, 16 hex chars
  value: Uint8Array;
  valueText: string | null; // the value as text when it is printable UTF-8
  valueHex: string;
}

/** Where metadata is attached: the account itself, one of its mosaics or one of its namespaces. */
export interface MetadataTargetRef {
  type: MetadataTargetType;
  address: string; // the owner's address (the target account; also the source of the entries unless `sourceAddress` is set)
  /** Whose entries we read and write. Omitted = the owner (own address / mosaic / namespace); set for another account's target. */
  sourceAddress?: string;
  targetId?: string; // mosaic id / namespace id (16 hex chars); not used for the account
}

function metadataQuery(ref: MetadataTargetRef, extra = ''): string {
  const addr = normalizeAddress(ref.address);
  const source = normalizeAddress(ref.sourceAddress ?? ref.address);
  const id = ref.type === 'account' || !ref.targetId ? '' : `&targetId=${ref.targetId.toUpperCase()}`;
  return `/metadata?sourceAddress=${source}&targetAddress=${addr}&metadataType=${METADATA_TYPE_CODE[ref.type]}${id}${extra}`;
}

function toMetadataEntry(raw: { scopedMetadataKey: string; value: string }): MetadataEntry {
  const value = hexToBytes(raw.value);
  return { key: raw.scopedMetadataKey.toUpperCase(), value, valueText: decodeValueText(value), valueHex: bytesToHex(value) };
}

type RawMetadataPage = { data: Array<{ metadataEntry: { scopedMetadataKey: string; value: string } }> };

/** Entries `sourceAddress` (default: the owner) has set on this target; entries set by other sources are not shown. */
export async function fetchMetadataEntries(ref: MetadataTargetRef): Promise<MetadataEntry[]> {
  const res = await nodeRequest<RawMetadataPage>(`${metadataQuery(ref, '&order=asc&pageSize=100')}`);
  return res.data.map((d) => toMetadataEntry(d.metadataEntry));
}

/** The current value stored under `key` (empty when the key has not been set yet). */
export async function fetchMetadataValue(ref: MetadataTargetRef, key: bigint): Promise<Uint8Array> {
  const res = await nodeRequest<RawMetadataPage>(metadataQuery(ref, `&scopedMetadataKey=${keyToHex(key)}`));
  const entry = res.data[0]?.metadataEntry;
  return entry ? hexToBytes(entry.value) : new Uint8Array(0);
}

/** Transaction fee (atomic XYM) of setting the given values on one target, at the standard level. */
export async function quoteMetadataFee(type: MetadataTargetType, valueLengths: number[]): Promise<FeeQuote> {
  return (await quoteFeesForSize(metadataAggregateSize(type, valueLengths)))[getDefaultFeeSpeed()];
}

export interface SetMetadataInput {
  privateKey: string;
  publicKey: string;
  address: string; // the owner's address
  target: MetadataTarget;
  items: MetadataItem[];
}

/** Sets (or overwrites) metadata on the owner's own account, mosaic or namespace. */
export async function setMetadata(input: SetMetadataInput): Promise<{ hash: string }> {
  const cfg = getNetworkConfig();
  const ref: MetadataTargetRef = {
    type: input.target.type,
    address: input.address,
    targetId: input.target.type === 'mosaic' ? input.target.mosaicId : input.target.type === 'namespace' ? input.target.namespaceId : undefined,
  };
  // Overwriting an existing key needs its current value (the transaction carries old XOR new).
  const changes: MetadataChange[] = await Promise.all(input.items.map(async (item) => ({
    target: input.target,
    key: item.key,
    oldValue: await fetchMetadataValue(ref, item.key),
    newValue: item.value,
  })));
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signMetadata(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    ownerAddress: input.address,
    networkByte: cfg.networkByte,
    changes,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

// --- account restrictions (アカウント制限) -------------------------------------------------------
/**
 * The restrictions an account has set: address / mosaic / operation lists, each in its own direction and
 * allow or block mode. An account that never set any is a normal case (the node answers 404) -> empty array.
 */
export async function fetchAccountRestrictions(address: string): Promise<RestrictionList[]> {
  try {
    const raw = await nodeRequest<RawAccountRestrictions>(`/restrictions/account/${normalizeAddress(address)}`);
    return parseAccountRestrictions(raw);
  } catch (e) {
    if ((e as { status?: number }).status === 404) return [];
    throw e;
  }
}

/** Fee (atomic XYM) of one restriction change at the standard level. */
export async function quoteAccountRestrictionFee(rule: RestrictionRule, additionCount: number, deletionCount: number): Promise<FeeQuote> {
  return (await quoteFeesForSize(restrictionTransactionSize(rule.kind, additionCount, deletionCount)))[getDefaultFeeSpeed()];
}

export interface SetAccountRestrictionInput {
  privateKey: string;
  publicKey: string;
  rule: RestrictionRule;
  mode: RestrictionMode;
  /** Canonical values (see restrictions.ts). */
  additions: string[];
  deletions: string[];
}

/** Adds / removes values on one of the wallet account's own restriction lists. */
export async function setAccountRestriction(input: SetAccountRestrictionInput): Promise<{ hash: string }> {
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signAccountRestriction(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    rule: input.rule,
    mode: input.mode,
    additions: input.additions,
    deletions: input.deletions,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

// --- harvesting ---------------------------------------------------------------------------
export interface HarvestStatus {
  remotePublicKey: string | null; // linked remote account
  vrfPublicKey: string | null;
  nodePublicKey: string | null; // linked node
  /** Voting keys linked now (finalization voting; separate from the three harvesting links), by start epoch. */
  votingKeys: LinkedVotingKey[];
  /** All three links exist, i.e. the account is set up for delegated harvesting. */
  linked: boolean;
  /** Some links exist but not all (e.g. a half-finished setup); they can still be removed. */
  partial: boolean;
  xymBalance: bigint;
  minBalance: bigint; // atomic XYM needed to harvest
  maxBalance: bigint; // atomic XYM above which the account can no longer harvest
  importance: bigint; // raw importance, 0n = none yet
}

export interface HarvestedBlock {
  height: string;
  timestampMs: number | null;
  totalFee: bigint; // all transaction fees of the block (not the harvester's own share)
}

/** Blocks signed by the account's linked remote (harvesting) key, newest first (at most `limit`). */
export async function fetchHarvestedBlocks(remotePublicKey: string, limit = 100): Promise<HarvestedBlock[]> {
  const cfg = getNetworkConfig();
  const res = await nodeRequest<{
    data: Array<{ meta?: { totalFee?: string }; block: { height: string; timestamp?: string } }>;
  }>(`/blocks?signerPublicKey=${remotePublicKey.toUpperCase()}&order=desc&pageSize=${limit}`);
  return res.data.map((d) => ({
    height: d.block.height,
    timestampMs: d.block.timestamp !== undefined ? Number(d.block.timestamp) + cfg.epochAdjustment * 1000 : null,
    totalFee: BigInt(d.meta?.totalFee ?? '0'),
  }));
}

// --- importance and network statistics ------------------------------------------------------
export interface ImportanceInfo {
  importance: bigint; // raw importance, 0n = none yet
  totalImportance: bigint | null; // the whole network's importance (null when unavailable)
  percent: number | null; // share of the network's importance, in percent
}

/** Importance score of an account: the raw value and its share of the network's total importance. */
export async function fetchImportanceInfo(address: string): Promise<ImportanceInfo> {
  const [acc, props] = await Promise.all([
    nodeRequest<{ account: { importance?: string } }>(`/accounts/${normalizeAddress(address)}`).catch((e) => {
      if ((e as { status?: number }).status === 404) return { account: {} as { importance?: string } };
      throw e;
    }),
    nodeRequest<{ chain?: { totalChainImportance?: string } }>('/network/properties').catch(() => null),
  ]);
  const importance = parseNetworkNumber(acc.account.importance) ?? 0n;
  const totalImportance = parseNetworkNumber(props?.chain?.totalChainImportance);
  const percent = totalImportance !== null && totalImportance > 0n ? (Number(importance) / Number(totalImportance)) * 100 : null;
  return { importance, totalImportance, percent };
}

export interface NetworkStats {
  height: string | null;
  finalizedHeight: string | null;
  finalizedEpoch: number | null;
  latestBlockTimeMs: number | null;
  /** Average seconds between the latest blocks (null when too few blocks could be read). */
  avgBlockSeconds: number | null;
  targetBlockSeconds: number | null;
  /**
   * Number of nodes on the network, every type counted with no role filter (Peer, API, Voting and the combinations
   * Peer API, Peer Voting, Api Voting, Peer Api Voting). It is the "Total count" the Symbol explorer shows: the sum of the
   * statistics service's per-role counts (GET /nodeCount). Where there is no statistics service (mijin v2) or it does not
   * answer, it falls back to the peers the connected node itself knows (GET /node/peers), which is only a part of the network.
   */
  peers: number | null;
  nodeName: string | null;
  nodeVersion: string | null;
  nodeHealthy: boolean | null;
  /** Version of the REST gateway the node answers through ("2.5.0"). Symbol nodes do not report an OS / platform like NIS1 does. */
  nodeRestVersion: string | null;
  feeMin: number | null; // fee multipliers (atomic units per byte)
  feeAverage: number | null;
  feeMedian: number | null;
  feeHighest: number | null;
  /** Fee levels in atomic XYM (null when the node could not be read): a plain transfer at the median multiplier, a root namespace for one year, a child namespace, a mosaic. */
  transferFeeMedian: bigint | null;
  rootNamespaceYearFee: bigint | null;
  childNamespaceFee: bigint | null;
  mosaicFee: bigint | null;
}

/** Size (bytes) of a plain transfer without a message, the reference for the transfer fee level. */
const REFERENCE_TRANSFER_SIZE = 176;

const versionText = (v: number): string => `${(v >>> 24) & 0xff}.${(v >>> 16) & 0xff}.${(v >>> 8) & 0xff}.${v & 0xff}`;

/** Number of nodes on the network, from NodeWatch's node list (limit=5000, like the reference apps), else the statistics service's /nodeCount. Null when neither answers. */
async function fetchNetworkNodeCount(cfg: ReturnType<typeof getNetworkConfig>): Promise<number | null> {
  if (cfg.nodeWatch) {
    try {
      const nodes = await fetchJson<Array<{ roles?: unknown }>>(`${cfg.nodeWatch}?limit=5000`, undefined, 10000);
      if (Array.isArray(nodes)) {
        const n = nodes.filter((x) => Number.isFinite(Number(x?.roles))).length;
        if (n > 0) return n;
      }
    } catch (e) {
      logWarn('symbol-node', `NodeWatch node list could not be read: ${(e as Error).message}`);
    }
  }
  if (cfg.statisticsService) {
    try {
      const res = await fetchJson<{ nodeTypes?: Record<string, unknown> }>(`${cfg.statisticsService}/nodeCount`, undefined, 8000);
      const types = res.nodeTypes;
      if (types && typeof types === 'object') {
        const n = Object.values(types).reduce<number>((sum, v) => (typeof v === 'number' && Number.isFinite(v) && v >= 0 ? sum + v : sum), 0);
        if (n > 0) return n;
      }
    } catch { /* no count */ }
  }
  return null;
}

/** Chain height, finalization, block time, peers, node and fee figures (every part is optional: a part that cannot be read is null). */
export async function fetchNetworkStats(): Promise<NetworkStats> {
  const cfg = getNetworkConfig();
  const [chain, peers, info, health, props, fees, blocks, server, nodeStats, rental] = await Promise.allSettled([
    nodeRequest<{ height: string; latestFinalizedBlock?: { height: string; finalizationEpoch: number } }>('/chain/info'),
    nodeRequest<unknown[]>('/node/peers'),
    nodeRequest<{ friendlyName?: string; version?: number }>('/node/info'),
    nodeRequest<{ status?: { apiNode?: string; db?: string } }>('/node/health'),
    nodeRequest<{ chain?: { totalChainImportance?: string; blockGenerationTargetTime?: string } }>('/network/properties'),
    nodeRequest<{ minFeeMultiplier?: number; averageFeeMultiplier?: number; medianFeeMultiplier?: number; highestFeeMultiplier?: number }>('/network/fees/transaction'),
    nodeRequest<{ data: Array<{ block: { height: string; timestamp?: string } }> }>('/blocks?pageSize=30&order=desc'),
    nodeRequest<{ serverInfo?: { restVersion?: string }; restVersion?: string }>('/node/server'),
    // Network-wide node count: NodeWatch's node list (every node, whatever its role), counted. Falls back to the statistics service's per-role counts ({ nodeTypes: { "1": 7, ... } }).
    fetchNetworkNodeCount(cfg),
    nodeRequest<{ effectiveRootNamespaceRentalFeePerBlock?: string; effectiveChildNamespaceRentalFee?: string; effectiveMosaicRentalFee?: string }>('/network/fees/rental'),
  ]);
  const ok = <T,>(r: PromiseSettledResult<T>): T | null => (r.status === 'fulfilled' ? r.value : null);
  const c = ok(chain);
  const i = ok(info);
  const h = ok(health);
  const p = ok(props);
  const f = ok(fees);
  const b = ok(blocks);
  const sv = ok(server);
  const networkNodes = ok(nodeStats);
  let avgBlockSeconds: number | null = null;
  let latestBlockTimeMs: number | null = null;
  const stamps = (b?.data ?? []).map((d) => (d.block.timestamp !== undefined ? Number(d.block.timestamp) : NaN)).filter((n) => Number.isFinite(n));
  if (stamps.length > 0) latestBlockTimeMs = stamps[0] + cfg.epochAdjustment * 1000;
  if (stamps.length >= 2) avgBlockSeconds = (stamps[0] - stamps[stamps.length - 1]) / (stamps.length - 1) / 1000;
  const target = Number((p?.chain?.blockGenerationTargetTime ?? '').replace(/[^0-9.]/g, ''));
  const rentalFees = ok(rental);
  const perBlock = parseNetworkNumber(rentalFees?.effectiveRootNamespaceRentalFeePerBlock);
  // Blocks in one year (365 days) at the network's target block time (30 s on Symbol mainnet and testnet).
  const blocksPerYear = Math.round((365 * 24 * 60 * 60) / (Number.isFinite(target) && target > 0 ? target : 30));
  return {
    height: c?.height ?? null,
    finalizedHeight: c?.latestFinalizedBlock?.height ?? null,
    finalizedEpoch: c?.latestFinalizedBlock?.finalizationEpoch ?? null,
    latestBlockTimeMs,
    avgBlockSeconds,
    targetBlockSeconds: Number.isFinite(target) && target > 0 ? target : null,
    // Without a statistics service (mijin v2) the connected node's own peer list is all there is; when the service is configured but does not answer, show nothing rather than a smaller number that disagrees with the explorer.
    peers: networkNodes !== null && networkNodes > 0 ? networkNodes : cfg.statisticsService || cfg.nodeWatch ? null : Array.isArray(ok(peers)) ? (ok(peers) as unknown[]).length : null,
    nodeName: i?.friendlyName ?? null,
    nodeVersion: typeof i?.version === 'number' ? versionText(i.version) : null,
    nodeHealthy: h?.status ? h.status.apiNode === 'up' && h.status.db === 'up' : null,
    // GET /node/server answers { serverInfo: { restVersion, sdkVersion } }; a bare { restVersion } is read as well.
    nodeRestVersion: sv?.serverInfo?.restVersion ?? sv?.restVersion ?? null,
    feeMin: f?.minFeeMultiplier ?? null,
    feeAverage: f?.averageFeeMultiplier ?? null,
    feeMedian: f?.medianFeeMultiplier ?? null,
    feeHighest: f?.highestFeeMultiplier ?? null,
    transferFeeMedian: (f?.medianFeeMultiplier ?? f?.averageFeeMultiplier) !== undefined ? BigInt(Math.round((f?.medianFeeMultiplier ?? f?.averageFeeMultiplier) as number)) * BigInt(REFERENCE_TRANSFER_SIZE) : null,
    rootNamespaceYearFee: perBlock !== null ? perBlock * BigInt(blocksPerYear) : null,
    childNamespaceFee: parseNetworkNumber(rentalFees?.effectiveChildNamespaceRentalFee),
    mosaicFee: parseNetworkNumber(rentalFees?.effectiveMosaicRentalFee),
  };
}

/**
 * Base URL for "open in explorer" links. mijin v2 has no public explorer: unless the person entered one, the links
 * open the REST gateway of the connected node (it answers with the same data as JSON).
 */
function explorerBase(): { base: string; rest: boolean } {
  const { explorer } = getNetworkConfig();
  if (explorer) return { base: explorer, rest: false };
  return { base: getConnectedNode() || getCustomNode() || getSavedNodes()[0] || '', rest: true };
}

export function explorerBlockUrl(height: string): string {
  return `${explorerBase().base}/blocks/${height}`;
}

const DEFAULT_MIN_HARVESTER_BALANCE = 10_000_000_000n; // 10,000 XYM
const DEFAULT_MAX_HARVESTER_BALANCE = 50_000_000_000_000n; // 50,000,000 XYM

// The node reports big numbers with ' separators ("10'000'000000").
function parseNetworkNumber(value: string | undefined): bigint | null {
  if (!value) return null;
  const digits = value.replace(/[^0-9]/g, '');
  return digits === '' ? null : BigInt(digits);
}

/** XYM an account must hold to harvest, and the most it may hold (from /network/properties; 10,000 / 50,000,000 XYM when unavailable). */
export async function fetchHarvesterLimits(): Promise<{ min: bigint; max: bigint }> {
  try {
    const res = await nodeRequest<{ chain?: { minHarvesterBalance?: string; maxHarvesterBalance?: string } }>('/network/properties');
    return {
      min: parseNetworkNumber(res.chain?.minHarvesterBalance) ?? DEFAULT_MIN_HARVESTER_BALANCE,
      max: parseNetworkNumber(res.chain?.maxHarvesterBalance) ?? DEFAULT_MAX_HARVESTER_BALANCE,
    };
  } catch {
    return { min: DEFAULT_MIN_HARVESTER_BALANCE, max: DEFAULT_MAX_HARVESTER_BALANCE };
  }
}

/** XYM an account must hold to harvest (from /network/properties; 10,000 XYM when unavailable). */
export async function fetchMinHarvesterBalance(): Promise<bigint> {
  return (await fetchHarvesterLimits()).min;
}

/** Links, balance and importance of an account. An unknown account (never received anything) reads as empty. */
export async function fetchHarvestStatus(address: string): Promise<HarvestStatus> {
  const cfg = getNetworkConfig();
  const { min: minBalance, max: maxBalance } = await fetchHarvesterLimits();
  interface AccountInfo {
    importance?: string;
    supplementalPublicKeys?: {
      linked?: { publicKey?: string }; node?: { publicKey?: string }; vrf?: { publicKey?: string };
      voting?: { publicKeys?: Array<{ publicKey: string; startEpoch: number | string; endEpoch: number | string }> };
    };
    mosaics?: Array<{ id: string; amount: string }>;
  }
  let account = null as AccountInfo | null;
  try {
    const res = await nodeRequest<{ account: AccountInfo }>(`/accounts/${normalizeAddress(address)}`);
    account = res.account;
  } catch (e) {
    if ((e as { status?: number }).status !== 404) throw e;
  }
  const keys = account?.supplementalPublicKeys;
  const remotePublicKey = keys?.linked?.publicKey?.toUpperCase() ?? null;
  const vrfPublicKey = keys?.vrf?.publicKey?.toUpperCase() ?? null;
  const nodePublicKey = keys?.node?.publicKey?.toUpperCase() ?? null;
  const votingKeys: LinkedVotingKey[] = (keys?.voting?.publicKeys ?? [])
    .map((k) => ({ publicKey: k.publicKey.toUpperCase(), startEpoch: Number(k.startEpoch), endEpoch: Number(k.endEpoch) }))
    .sort((a, b) => a.startEpoch - b.startEpoch || a.endEpoch - b.endEpoch);
  const count = [remotePublicKey, vrfPublicKey, nodePublicKey].filter((k) => k !== null).length;
  const xym = account?.mosaics?.find((m) => m.id.toUpperCase() === cfg.currencyMosaicId);
  return {
    remotePublicKey,
    vrfPublicKey,
    nodePublicKey,
    votingKeys,
    linked: count === 3,
    partial: count > 0 && count < 3,
    xymBalance: xym ? BigInt(xym.amount) : 0n,
    minBalance,
    maxBalance,
    importance: account?.importance ? BigInt(account.importance) : 0n,
  };
}

export interface HarvestNode {
  publicKey: string; // the node's public key (what the link and the delegation request use)
  name: string;
  host: string;
  /** Address of the node's REST gateway when it has one (so it can be checked before it is chosen). */
  restUrl?: string;
}

/** The node the wallet is currently connected to (its public key, for a one-tap choice). */
export async function fetchConnectedHarvestNode(): Promise<HarvestNode | null> {
  try {
    const url = await resolveNode();
    const info = await nodeRequest<{ nodePublicKey?: string; friendlyName?: string; host?: string }>('/node/info');
    if (!info.nodePublicKey) return null;
    return {
      publicKey: info.nodePublicKey.toUpperCase(),
      name: info.friendlyName || info.host || url,
      host: info.host || url.replace(/^https?:\/\//, ''),
      restUrl: url,
    };
  } catch {
    return null;
  }
}

/** Turns what was typed ("node.example.com:3001", "http://localhost:3000/") into a base URL; null when it is not a URL. */
export function normalizeNodeUrl(input: string): string | null {
  const text = input.trim();
  if (text === '') return null;
  const withScheme = /^https?:\/\//i.test(text) ? text : `https://${text}`;
  try {
    const u = new URL(withScheme);
    if (!u.hostname.includes('.') && u.hostname !== 'localhost' && !/^\[/.test(u.hostname)) return null;
    const base = `${u.protocol}//${u.host}`;
    return isAllowedNodeUrl(base) ? base : null; // http:// only for this computer / the local network
  } catch {
    return null;
  }
}

/**
 * Asks the node at `url` for its public key (/node/info), so a node can be chosen by its URL.
 * Throws an Error whose message is 'invalid_url' | 'unreachable' | 'wrong_network' | 'no_key'.
 */
export async function fetchHarvestNodeByUrl(url: string): Promise<HarvestNode> {
  const base = normalizeNodeUrl(url);
  if (base === null) throw new Error('invalid_url');
  let info: { nodePublicKey?: string; friendlyName?: string; host?: string; networkIdentifier?: number };
  try {
    info = await fetchJson<typeof info>(`${base}/node/info`, undefined, 8000);
  } catch {
    throw new Error('unreachable');
  }
  if (info.networkIdentifier !== undefined && info.networkIdentifier !== getNetworkConfig().networkByte) throw new Error('wrong_network');
  if (!info.nodePublicKey || !/^[0-9a-fA-F]{64}$/.test(info.nodePublicKey)) throw new Error('no_key');
  return {
    publicKey: info.nodePublicKey.toUpperCase(),
    name: info.friendlyName || info.host || base,
    host: info.host || base.replace(/^https?:\/\//, ''),
    restUrl: base,
  };
}

/** Public nodes from the statistics service that are peers (candidates for delegated harvesting). */
export async function fetchHarvestNodeCandidates(): Promise<HarvestNode[]> {
  const cfg = getNetworkConfig();
  try {
    const nodes = await fetchJson<Array<{
      roles?: number;
      friendlyName?: string;
      host?: string;
      nodePublicKey?: string;
      apiStatus?: { nodePublicKey?: string; isAvailable?: boolean; restGatewayUrl?: string };
    }>>(`${cfg.statisticsService}/nodes?filter=preferred&limit=60`, undefined, 8000);
    const seen = new Set<string>();
    const out: HarvestNode[] = [];
    for (const n of nodes) {
      const publicKey = (n.apiStatus?.nodePublicKey ?? n.nodePublicKey ?? '').toUpperCase();
      // roles is a bit field: 1 = peer, 2 = api. Only peers harvest.
      if (!/^[0-9A-F]{64}$/.test(publicKey) || ((n.roles ?? 1) & 1) === 0 || seen.has(publicKey)) continue;
      seen.add(publicKey);
      // The address comes from the public directory (anyone can list a node): plain http on the open internet is not used.
      const restUrl = n.apiStatus?.restGatewayUrl && isAllowedNodeUrl(n.apiStatus.restGatewayUrl) ? n.apiStatus.restGatewayUrl.replace(/\/+$/, '') : undefined;
      out.push({ publicKey, name: n.friendlyName || n.host || publicKey.slice(0, 8), host: n.host ?? '', restUrl });
    }
    return out.sort((a, b) => a.name.localeCompare(b.name));
  } catch {
    return [];
  }
}

/** What was found out about a node before it is chosen for delegated harvesting (null = could not be checked). */
export interface HarvestNodeCheck {
  reachable: boolean | null; // null: the node has no REST address to ask
  networkMatches: boolean | null;
  isPeer: boolean | null; // only peer nodes harvest
  keyMatches: boolean | null; // the public key the node reports for itself is the one to be linked
  behindBlocks: number | null; // how far the node is behind the node this wallet is connected to
  healthy: boolean | null;
}

/** Asks the node's REST gateway (/node/info, /node/health, /chain/info) whether it can be used for delegated harvesting. */
export async function checkHarvestNode(node: HarvestNode | null, chosenKey: string): Promise<HarvestNodeCheck> {
  const empty: HarvestNodeCheck = { reachable: null, networkMatches: null, isPeer: null, keyMatches: null, behindBlocks: null, healthy: null };
  if (!node?.restUrl) return empty;
  const base = node.restUrl;
  let info: { nodePublicKey?: string; networkIdentifier?: number; roles?: number };
  try {
    info = await fetchJson<typeof info>(`${base}/node/info`, undefined, 8000);
  } catch {
    return { ...empty, reachable: false };
  }
  const [health, chain, own] = await Promise.allSettled([
    fetchJson<{ status?: { apiNode?: string; db?: string } }>(`${base}/node/health`, undefined, 8000),
    fetchJson<{ height?: string }>(`${base}/chain/info`, undefined, 8000),
    nodeRequest<{ height?: string }>('/chain/info'),
  ]);
  const healthStatus = health.status === 'fulfilled' ? health.value.status : undefined;
  const theirs = chain.status === 'fulfilled' && chain.value.height ? Number(chain.value.height) : null;
  const ours = own.status === 'fulfilled' && own.value.height ? Number(own.value.height) : null;
  return {
    reachable: true,
    networkMatches: info.networkIdentifier !== undefined ? info.networkIdentifier === getNetworkConfig().networkByte : null,
    isPeer: info.roles !== undefined ? (info.roles & 1) !== 0 : null,
    keyMatches: info.nodePublicKey && /^[0-9a-fA-F]{64}$/.test(info.nodePublicKey) ? info.nodePublicKey.toUpperCase() === chosenKey.toUpperCase() : null,
    behindBlocks: theirs !== null && ours !== null ? Math.max(0, ours - theirs) : null,
    healthy: healthStatus ? healthStatus.apiNode === 'up' && healthStatus.db === 'up' : null,
  };
}

/** Transaction fees (atomic XYM, standard level) of the link aggregate and of the delegation request. */
export async function quoteHarvestFees(linkCount: number, withDelegation: boolean): Promise<{ links: FeeQuote; delegation: FeeQuote | null }> {
  const multipliers = await feeMultipliers();
  const quote = (size: number): FeeQuote => ({ multiplier: multipliers[getDefaultFeeSpeed()], size, fee: BigInt(size) * BigInt(multipliers[getDefaultFeeSpeed()]) });
  return { links: quote(harvestLinkSize(linkCount)), delegation: withDelegation ? quote(harvestDelegationSize()) : null };
}

/** Fee of a one-key change and of a replacement (two keys) at each of the five levels (one node request). */
export async function quoteHarvestLinkFees(): Promise<Record<FeeSpeed, { one: bigint; two: bigint }>> {
  const multipliers = await feeMultipliers();
  const at = (speed: FeeSpeed) => ({
    one: BigInt(harvestLinkSize(1)) * BigInt(multipliers[speed]),
    two: BigInt(harvestLinkSize(2)) * BigInt(multipliers[speed]),
  });
  const out = {} as Record<FeeSpeed, { one: bigint; two: bigint }>;
  for (const speed of FEE_SPEEDS) out[speed] = at(speed);
  return out;
}

/** Where the throw-away keys of a start are kept (encrypted) so the delegation request can be sent again later. */
export interface HarvestKeyStore {
  save(keys: { remotePrivateKey: string; vrfPrivateKey: string }): Promise<void>;
  discard(): Promise<void>;
}

export interface StartHarvestingInput {
  privateKey: string;
  publicKey: string;
  nodePublicKey: string;
  keyStore?: HarvestKeyStore;
}

/**
 * Turns delegated harvesting on: links a new remote account, a new VRF account and the node, then
 * sends the node the encrypted request to harvest for us. The throw-away keys are not kept - the
 * node holds them, and later unlinking only needs the public keys that are on the chain. With a `keyStore` they are kept
 * (encrypted) as well: saved BEFORE anything is announced, so a start whose request fails after the links went through can be
 * resent; discarded again if the links themselves are refused (then nothing is linked and the keys are of no use).
 */
export async function startHarvesting(input: StartHarvestingInput): Promise<{ linkHash: string; delegationHash: string }> {
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const remote = newHarvestKeyPair();
  const vrf = newHarvestKeyPair();
  const links = signHarvestLinks(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    links: [
      { kind: 'remote', publicKey: remote.publicKey, link: true },
      { kind: 'vrf', publicKey: vrf.publicKey, link: true },
      { kind: 'node', publicKey: input.nodePublicKey, link: true },
    ],
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  const delegation = signHarvestDelegation(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    nodePublicKey: input.nodePublicKey,
    remotePrivateKey: remote.privateKey,
    vrfPrivateKey: vrf.privateKey,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  if (input.keyStore) await input.keyStore.save({ remotePrivateKey: remote.privateKey, vrfPrivateKey: vrf.privateKey });
  // The links go first: if the network refuses them (not enough XYM, already linked) the node
  // never receives the keys.
  try {
    await announceSigned(links);
  } catch (e) {
    if (input.keyStore) await input.keyStore.discard().catch(() => { /* nothing useful to do */ });
    throw e;
  }
  await announceSigned(delegation);
  return { linkHash: links.hash, delegationHash: delegation.hash };
}

export interface StopHarvestingInput {
  privateKey: string;
  publicKey: string;
  status: HarvestStatus; // the links to remove (read from the chain)
}

/** Turns harvesting off by unlinking every key that is currently linked. */
export async function stopHarvesting(input: StopHarvestingInput): Promise<{ hash: string }> {
  const cfg = getNetworkConfig();
  const links: HarvestLink[] = [];
  if (input.status.remotePublicKey) links.push({ kind: 'remote', publicKey: input.status.remotePublicKey, link: false });
  if (input.status.vrfPublicKey) links.push({ kind: 'vrf', publicKey: input.status.vrfPublicKey, link: false });
  if (input.status.nodePublicKey) links.push({ kind: 'node', publicKey: input.status.nodePublicKey, link: false });
  if (links.length === 0) throw new SymbolSendError('nothing_linked');
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signHarvestLinks(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    links,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

export interface ChangeHarvestKeysInput {
  privateKey: string;
  publicKey: string;
  links: HarvestLink[]; // what to link / unlink, in this order (see planKeyChange in harvestKeys.ts)
  feeSpeed?: FeeSpeed; // fee level (the 手数料の既定値 when omitted)
}

/**
 * Links and/or unlinks individual harvesting keys (remote / VRF / node) given by their public keys, in one aggregate.
 * Unlike startHarvesting this makes no keys and sends no delegation request: the private keys of a remote / VRF key
 * belong to whoever runs the node.
 */
export async function changeHarvestKeys(input: ChangeHarvestKeysInput): Promise<{ hash: string }> {
  if (input.links.length === 0) throw new SymbolSendError('nothing_to_change');
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signHarvestLinks(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    links: input.links,
    feeMultiplier: multipliers[input.feeSpeed ?? getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

export interface ResendDelegationInput {
  privateKey: string; // the main account's key (signs the request)
  publicKey: string;
  remotePrivateKey: string;
  vrfPrivateKey: string;
  status: HarvestStatus; // the links as they are on the chain now (read right before)
}

/**
 * 委任リクエストの再送: sends the node that is linked now the encrypted request (FormPersistentDelegationRequest) again,
 * for the remote and VRF private keys the person typed. Nothing is linked or unlinked. The keys must belong to the remote / VRF
 * public keys linked on the chain (SymbolSendError 'not_linked' / 'delegation_keys_mismatch' otherwise, nothing is sent).
 */
export async function resendHarvestDelegation(input: ResendDelegationInput): Promise<{ hash: string }> {
  const plan = planDelegationResend(input.status, input.remotePrivateKey, input.vrfPrivateKey);
  if (!plan.ok) throw new SymbolSendError(plan.error === 'not_linked' ? 'not_linked' : 'delegation_keys_mismatch', plan.error);
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signHarvestDelegation(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    nodePublicKey: plan.nodePublicKey,
    remotePrivateKey: plan.remotePrivateKey,
    vrfPrivateKey: plan.vrfPrivateKey,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

// --- voting keys (finalization) ------------------------------------------------------------
export interface VotingContext {
  currentEpoch: number | null; // the latest finalized epoch (null when the node does not tell)
  limits: VotingLimits;
}

/** The finalized epoch now and the network's limits for voting key links (mainnet defaults when unavailable). */
export async function fetchVotingContext(): Promise<VotingContext> {
  let currentEpoch: number | null = null;
  try {
    const info = await nodeRequest<{ latestFinalizedBlock?: { finalizationEpoch?: number | string } }>('/chain/info');
    const epoch = Number(info.latestFinalizedBlock?.finalizationEpoch);
    if (Number.isInteger(epoch) && epoch > 0) currentEpoch = epoch;
  } catch { /* the form simply has no suggested range */ }
  const limits: VotingLimits = { ...DEFAULT_VOTING_LIMITS };
  try {
    const res = await nodeRequest<{ chain?: { minVotingKeyLifetime?: string; maxVotingKeyLifetime?: string; maxVotingKeysPerAccount?: string } }>('/network/properties');
    const num = (v: string | undefined): number | null => { const n = parseNetworkNumber(v); return n === null ? null : Number(n); };
    limits.minLifetime = num(res.chain?.minVotingKeyLifetime) ?? limits.minLifetime;
    limits.maxLifetime = num(res.chain?.maxVotingKeyLifetime) ?? limits.maxLifetime;
    limits.maxKeys = num(res.chain?.maxVotingKeysPerAccount) ?? limits.maxKeys;
  } catch { /* defaults */ }
  return { currentEpoch, limits };
}

/** Transaction fee (atomic XYM, standard level) of a voting key link aggregate holding `linkCount` links. */
export async function quoteVotingFee(linkCount: number): Promise<FeeQuote> {
  const multipliers = await feeMultipliers();
  const size = votingLinkSize(linkCount);
  return { multiplier: multipliers[getDefaultFeeSpeed()], size, fee: BigInt(size) * BigInt(multipliers[getDefaultFeeSpeed()]) };
}

export interface ChangeVotingKeysInput {
  privateKey: string;
  publicKey: string;
  links: VotingLink[]; // what to link / unlink (see planVotingLink / planVotingUnlink in votingKeys.ts)
}

/** Links and/or unlinks voting keys (key + epoch range) in one aggregate. */
export async function changeVotingKeys(input: ChangeVotingKeysInput): Promise<{ hash: string }> {
  if (input.links.length === 0) throw new SymbolSendError('nothing_to_change');
  const cfg = getNetworkConfig();
  const multipliers = await feeMultipliers();
  const deadline = BigInt(await networkTimeMs()) + 2n * 60n * 60n * 1000n;
  const signed = signVotingKeyLinks(input.privateKey, cfg.generationHash, {
    signerPublicKey: input.publicKey,
    networkByte: cfg.networkByte,
    links: input.links,
    feeMultiplier: multipliers[getDefaultFeeSpeed()],
    deadline,
  });
  await announceSigned(signed);
  return { hash: signed.hash };
}

// --- harvest rewards ----------------------------------------------------------------------
export interface HarvestReward {
  height: string;
  timestampMs: number | null; // null when the node did not report the block time
  amount: string; // XYM, plain decimal
  atomic: bigint;
}

const RECEIPT_TYPE_HARVEST_FEE = 8515; // 0x2143

/** Latest harvest rewards paid to this address (from the block statements), newest first. */
export async function fetchHarvestRewards(address: string, count: number): Promise<HarvestReward[]> {
  const cfg = getNetworkConfig();
  const addr = normalizeAddress(address);
  const res = await nodeRequest<{
    data: Array<{
      meta?: { timestamp?: string };
      statement: { height: string; receipts: Array<{ type: number; targetAddress?: string; mosaicId?: string; amount: string }> };
    }>;
  }>(`/statements/transaction?targetAddress=${addr}&receiptType=${RECEIPT_TYPE_HARVEST_FEE}&order=desc&pageSize=${Math.min(Math.max(count, 10), 100)}`);
  const rewards: HarvestReward[] = [];
  for (const entry of res.data) {
    let atomic = 0n;
    for (const r of entry.statement.receipts) {
      if (r.type !== RECEIPT_TYPE_HARVEST_FEE) continue;
      if (r.targetAddress && addressBytesToString(hexToBytes(r.targetAddress)) !== addr) continue;
      atomic += BigInt(r.amount);
    }
    if (atomic === 0n) continue;
    rewards.push({
      height: entry.statement.height,
      timestampMs: entry.meta?.timestamp !== undefined ? Number(entry.meta.timestamp) + cfg.epochAdjustment * 1000 : null,
      amount: formatAtomic(atomic, CURRENCY_DIVISIBILITY),
      atomic,
    });
  }
  return rewards.slice(0, count);
}

export function explorerNamespaceUrl(name: string): string {
  const { base, rest } = explorerBase();
  if (!rest) return `${base}/namespaces/${name}`;
  // The REST gateway wants the namespace id, not the name.
  let parent = 0n;
  for (const label of name.split('.')) parent = BigInt(generateNamespaceId(label, parent));
  return `${base}/namespaces/${parent.toString(16).toUpperCase().padStart(16, '0')}`;
}

export function explorerTxUrl(hash: string): string {
  const { base, rest } = explorerBase();
  return `${base}/transactions/${rest ? 'confirmed/' : ''}${hash}`;
}

export function explorerAccountUrl(address: string): string {
  return `${explorerBase().base}/accounts/${normalizeAddress(address)}`;
}

export function explorerMosaicUrl(id: string): string {
  return `${explorerBase().base}/mosaics/${id}`;
}
